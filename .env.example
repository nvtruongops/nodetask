# ==============================================================================
# nodetask Environment Variables (Self-Hosted / Zero-Cloud)
# ==============================================================================

# Application Environment
NODE_ENV=your_strong_secret_here
VITE_APP_ENV=your_strong_secret_here
VITE_SERVER_URL=your_strong_secret_here

# 1. PostgreSQL Database Credentials (Self-Hosted Port 5432)
POSTGRES_DB=your_strong_secret_here
POSTGRES_USER=your_strong_secret_here
POSTGRES_PASSWORD=your_strong_secret_here
POSTGRES_PORT=your_strong_secret_here

# 2. Redis Distributed Cache (Self-Hosted Port 6379)
REDIS_HOST=your_strong_secret_here
REDIS_PORT=your_strong_secret_here
REDIS_PASSWORD=your_strong_secret_here

# 3. MinIO S3-Compatible Object Storage (Self-Hosted Ports 9000 & 9001)
MINIO_ROOT_USER=your_strong_secret_here
MINIO_ROOT_PASSWORD=your_strong_secret_here
MINIO_ENDPOINT=your_strong_secret_here
MINIO_CONSOLE_URL=your_strong_secret_here
MINIO_DEFAULT_BUCKETS=your_strong_secret_here

# 4. Serverpod Backend Security Secrets (512-bit / 256-bit Entropy)
SERVERPOD_SERVICE_SECRET=your_strong_secret_here
SERVERPOD_JWT_SECRET=your_strong_secret_here
SESSION_ENCRYPTION_KEY=your_strong_secret_here

# 5. Local AI & LLM Engine (Self-Hosted Ollama / LocalAI / Private Gateway)
AI_ENDPOINT_URL=your_strong_secret_here
AI_API_KEY=your_strong_secret_here
