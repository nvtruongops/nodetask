# ==============================================================================
# nodetask Monorepo Environment Variables Template (.env.example)
# Copy this file to .env and update local values as needed.
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=todo_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Distributed Caching (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Serverpod Framework Ports & Secrets
SERVERPOD_API_PORT=8080
SERVERPOD_WEB_PORT=8082
SERVERPOD_INSIGHTS_PORT=8081
SERVERPOD_SERVICE_SECRET=nodetask-dev-service-secret-change-me

# Frontend Web Application (React Vite)
VITE_SERVER_URL=http://localhost:8080
VITE_APP_TITLE=nodetask

# AI Semantic Search & RAG Assistant Keys (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
