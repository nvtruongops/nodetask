{
  "context-sentry": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/hooks/context-sentry.js",
        "timeout": 3
      }
    ]
  },
  "payload-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/payload-guard.js",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "script-lifecycle-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks/script-lifecycle-guard.js",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
